<%@ Page Title="" Language="C#" MasterPageFile="~/NestedMasterPageCRM.master" AutoEventWireup="true" CodeBehind="TicketsDetalheWebForm.aspx.cs" Inherits="VendasWeb.SAC.TicketsDetalheWebForm" %>

<%@ Register Src="~/usercontrol/TicketWebUserControl.ascx" TagPrefix="uc1" TagName="TicketWebUserControl" %>

