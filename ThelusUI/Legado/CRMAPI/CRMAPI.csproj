<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CRMAPI</RootNamespace>
    <AssemblyName>CRMAPI</AssemblyName>
    <OutputType>Library</OutputType>

    <!-- Força a saída de compilação diretamente para a pasta bin/ exigida pelo IIS/ASP.NET -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- GUIDs de Web Application (.NET Framework Web API) -->
    <ProjectTypeGuids>{349c5851-65df-11da-9384-00065b846f21};{fae04ec0-301f-11d3-bf4b-00c04f79efbc}</ProjectTypeGuids>

    <!-- Habilita o IIS Express no Visual Studio -->
    <UseIISExpress>true</UseIISExpress>
    <IISExpressSSLPort />
    <IISExpressAnonymousAuthentication />
    <IISExpressWindowsAuthentication />
    <IISExpressUseClassicPipelineMode />

    <!-- Define explicitamente o executável do IIS Express -->
    <RunCommand>$(ProgramFiles)\IIS Express\iisexpress.exe</RunCommand>
    <RunArguments>/path:"$(MSBuildProjectDirectory)" /port:50000</RunArguments>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>

    <!-- Configurações Web / IIS -->
    <MvcBuildViews>false</MvcBuildViews>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Garante a publicação dos arquivos de configuração e views do System.Web -->
  <ItemGroup>
    <Content Include="Web.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Global.asax" />
    <Content Include="Views\**\*.*" />
    <Content Include="Areas\**\*.*" />
  </ItemGroup>

