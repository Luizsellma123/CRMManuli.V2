@typeparam TItem
@using System.Reflection
@using Thelus.UI.Engine.Modelos
@using System.Linq

<div class="thelus-grid-container bg-body-tertiary p-3 rounded shadow-sm border">
    <!-- Cabeçalho do Grid (Título + Pesquisa + Itens por Página) -->
    @if (!string.IsNullOrEmpty(Title) || ShowSearch || ShowPageSizeSelector)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h5 class="m-0 text-body fw-bold">@Title</h5>
            }

            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (ShowPageSizeSelector && ShowPagination)
                {
                    <div class="d-flex align-items-center gap-1 text-muted small">
                        <span>Exibir</span>
                        <select class="form-select form-select-sm" style="width: 75px;" @onchange="OnPageSizeChanged">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                    </div>
                }

                @if (ShowSearch)
                {
                    <div class="input-group input-group-sm" style="max-width: 250px;">
                        <span class="input-group-text bg-body border-end-0">
                            <i class="mdi mdi-magnify"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Pesquisar..." 
                               value="@SearchTerm" @oninput="OnSearchInput" />
                    </div>
                }
            </div>
        </div>
    }

    <!-- Tabela Padronizada -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="text-muted border-bottom">
                <tr>
                    @foreach (var col in Columns)
                    {
                        <th style="@(string.IsNullOrEmpty(col.Width) ? "" : $"width: {col.Width};")" 
                            class="@GetAlignmentClass(col)">
                            @col.Header
                        </th>
                    }
                    @if (ShowActions)
                    {
                        <th class="text-center" style="width: 100px;">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (PaginatedItems != null && PaginatedItems.Any())
                {
                    @foreach (var item in PaginatedItems)
                    {
                        <tr>
                            @foreach (var col in Columns)
                            {
                                var rawValue = col.PropertyInfo.GetValue(item);
                                <td class="@GetAlignmentClass(col)">
                                    @RenderCellValue(col, rawValue)
                                </td>
                            }
                            @if (ShowActions)
                            {
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        @if (OnEdit.HasDelegate)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary px-2 py-1" @onclick="() => HandleEdit(item)" title="Editar">
                                                <i class="mdi mdi-pencil font-size-13"></i>
                                            </button>
                                        }
                                        @if (OnDelete.HasDelegate)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1" @onclick="() => HandleDelete(item)" title="Excluir">
                                                <i class="mdi mdi-trash-can font-size-13"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(Columns.Count + (ShowActions ? 1 : 0))" class="text-center py-4 text-muted">
                            <i class="mdi mdi-database-remove font-size-20 d-block mb-1"></i>
                            Nenhum registro encontrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Rodapé de Paginação -->
    @if (ShowPagination && TotalItems > 0)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 mt-2 border-top gap-2">
            <div class="text-muted small">
                Exibindo <strong>@StartRecord</strong> a <strong>@EndRecord</strong> de <strong>@TotalItems</strong> registros
            </div>

            @if (TotalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Botão Anterior -->
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Anterior</button>
                        </li>

                        <!-- Páginas Numéricas -->
                        @for (int p = FirstVisiblePage; p <= LastVisiblePage; p++)
                        {
                            var pageNum = p;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                            </li>
                        }

                        <!-- Botão Próximo -->
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Próximo</button>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;

    // Parâmetros de Paginação
    [Parameter] public bool ShowPagination { get; set; } = true;
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 10;

    [Parameter] public EventCallback<TItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }

    private List<ColumnMetadata> Columns { get; set; } = new List<ColumnMetadata>();
    private string SearchTerm { get; set; } = string.Empty;
    private int CurrentPage { get; set; } = 1;

    protected override void OnParametersSet()
    {
        // 1. Resolve o Tipo de forma segura
        Type targetType = typeof(TItem);

        if (targetType == typeof(object) && Items != null)
        {
            var itemType = Items.GetType().GetInterfaces()
                .FirstOrDefault(i => i.IsGenericType && i.GetGenericTypeDefinition() == typeof(IEnumerable<>))
                ?.GetGenericArguments()[0];

            if (itemType != null)
            {
                targetType = itemType;
            }
        }

        // 2. Busca as colunas filtradas pelo GridMetadataReader
        Columns = GridMetadataReader.GetColumns(targetType);
    }

    // Coleção filtrada com base na pesquisa
    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (Items == null) return Enumerable.Empty<TItem>();
            if (string.IsNullOrWhiteSpace(SearchTerm)) return Items;

            return Items.Where(item =>
            {
                foreach (var col in Columns)
                {
                    var val = col.PropertyInfo.GetValue(item)?.ToString();
                    if (val != null && val.IndexOf(SearchTerm, StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        return true;
                    }
                }
                return false;
            });
        }
    }

    // Aplica Skip/Take para paginar os dados
    private IEnumerable<TItem> PaginatedItems
    {
        get
        {
            if (!ShowPagination) return FilteredItems;
            return FilteredItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
        }
    }

    // Cálculos de Auxílio da Paginação
    private int TotalItems => FilteredItems.Count();
    private int TotalPages => (int)Math.Ceiling((double)TotalItems / PageSize);
    private int StartRecord => TotalItems == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int EndRecord => Math.Min(CurrentPage * PageSize, TotalItems);

    // Limita a quantidade de números visíveis no controle
    private int FirstVisiblePage => Math.Max(1, CurrentPage - 2);
    private int LastVisiblePage => Math.Min(TotalPages, FirstVisiblePage + 4);

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1; // Reseta para a primeira página ao pesquisar
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            PageSize = newSize;
            CurrentPage = 1; // Reseta para a primeira página ao mudar a quantidade por página
        }
    }

    private string GetAlignmentClass(ColumnMetadata col)
    {
        if (col?.PropertyType == null) return "text-start";
        
        var type = Nullable.GetUnderlyingType(col.PropertyType) ?? col.PropertyType;

        if (type == typeof(bool) || type == typeof(DateTime) || type == typeof(int) || type == typeof(long))
            return "text-center";

        if (type == typeof(decimal) || type == typeof(double) || type == typeof(float))
            return "text-end";

        return "text-start";
    }

    private RenderFragment RenderCellValue(ColumnMetadata col, object val) => builder =>
    {
        if (val == null)
        {
            builder.AddContent(0, "-");
            return;
        }

        var type = Nullable.GetUnderlyingType(col.PropertyType) ?? col.PropertyType;

        if (type == typeof(bool))
        {
            bool boolVal = (bool)val;
            string badgeClass = boolVal ? "bg-success" : "bg-secondary";
            string text = boolVal ? "Sim" : "Não";

            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"badge {badgeClass}");
            builder.AddContent(2, text);
            builder.CloseElement();
        }
        else if (type == typeof(DateTime))
        {
            DateTime dt = (DateTime)val;
            string defaultFormat = dt.TimeOfDay == TimeSpan.Zero ? "dd/MM/yyyy" : "dd/MM/yyyy HH:mm";
            string format = string.IsNullOrEmpty(col.Format) ? defaultFormat : col.Format;
            builder.AddContent(0, dt.ToString(format));
        }
        else if (type == typeof(decimal) || type == typeof(double))
        {
            string format = string.IsNullOrEmpty(col.Format) ? "C2" : col.Format;
            builder.AddContent(0, string.Format($"{{0:{format}}}", val));
        }
        else
        {
            builder.AddContent(0, val.ToString());
        }
    };

    private async Task HandleEdit(TItem item)
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(item);
        }
    }

    private async Task HandleDelete(TItem item)
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(item);
        }
    }
}