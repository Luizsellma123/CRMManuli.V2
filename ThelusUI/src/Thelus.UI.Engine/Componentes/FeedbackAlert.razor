#nullable enable

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade in mb-3" role="alert">
        <button type="button" class="close" @onclick="OnDismiss" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        <strong>@(IsSuccess ? "Sucesso!" : "Atenção!")</strong> @Message
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsSuccess { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
}