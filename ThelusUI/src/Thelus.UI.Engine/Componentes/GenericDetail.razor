@using System.Collections.Generic
@using System.Linq
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Thelus.UI.Engine.Servicos
@using Thelus.UI.Engine.Modelos
@using Thelus.UI.Engine.Atributos
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<style>
    .btn-menu-escuro,
    .btn-menu-escuro:before,
    .btn-menu-escuro i {
        color: #2c3e50 !important;
    }
</style>

<div class="row">
    <!-- Formulário Dinâmico da Seção Ativa (9 Colunas) -->
    <div class="col-sm-9">

        <!-- 1. FEEDBACK -->
        <FeedbackAlert Message="@mensagemFeedback" IsSuccess="@sucessoFeedback" OnDismiss="() => mensagemFeedback = null" />

        <div class="panel panel-info">
            <!-- CABEÇALHO DO PAINEL -->
            <div class="panel-heading">
                <div class="panel-control">
                    <button type="button" class="btn btn-default" data-target="#secao-conteudo" data-toggle="collapse">
                        <i class="fa fa-chevron-down"></i>
                    </button>
                </div>
                <h3 class="panel-title">@GetPanelTitle()</h3>
            </div>

            <!-- CONTEÚDO DO PAINEL -->
            <div class="collapse in" id="secao-conteudo" aria-expanded="true">
                <div class="panel-body">
                    @if (carregando)
                    {
                        <div class="text-center" style="padding: 30px;">
                            <i class="fa fa-spinner fa-spin fa-2x text-info"></i>
                            <p class="mt-2 text-muted">Carregando formulário...</p>
                        </div>
                    }
                    else if (modelInstance != null && propriedadesPorSecao.ContainsKey(secaoAtiva))
                    {
                        var propriedadesDaSecao = propriedadesPorSecao[secaoAtiva];
                        var propGrid = propriedadesDaSecao.FirstOrDefault(p => p.FieldType == FieldType.Grid);
                        var propComCabecalho = propriedadesDaSecao.FirstOrDefault(p => p.ContextHeaderProps != null && p.ContextHeaderProps.Any());

                        <!-- 2. CABEÇALHO DE CONTEXTO -->
                        <DetailContextHeader ModelInstance="@modelInstance" PropertyWithHeader="@propComCabecalho" />

                        <!-- 3. GRID OU FORMULÁRIO -->
                        if (propGrid != null)
                        {
                            <DetailSubGrid PropGrid="@propGrid"
                                           ModelInstance="@modelInstance"
                                           SectionName="@secaoAtiva"
                                           OnExecuteAction="ExecutarAcao" />
                        }
                        else
                        {
                            <div class="row">
                                @foreach (var prop in propriedadesDaSecao.OrderBy(p => p.Order))
                                {
                                    <DynamicFormField @key="prop.PropertyName"
                                                      Property="@prop" 
                                                      ModelInstance="@modelInstance" 
                                                      OnModelChanged="StateHasChanged" />
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Nenhuma configuração de modelo encontrada para a entidade <strong>@EntityName</strong>.
                        </div>
                    }
                </div>

                <!-- 4. RODAPÉ DE AÇÕES -->
                <DetailActionFooter Actions="@GetAcoesDaSecaoAtiva()" IsSaving="@salvando" OnExecuteAction="ExecutarAcao" />
            </div>
        </div>
    </div>

    <!-- 5. MENU LATERAL DIREITO -->
    <GenericDetailSideMenu Sections="@propriedadesPorSecao.Keys"
                           ActiveSection="@secaoAtiva"
                           OnSectionChanged="MudarSecao" />
</div>

@code {
    #nullable enable

    [Parameter] public string EntityName { get; set; } = string.Empty;
    [Parameter] public int Id { get; set; }
    [Parameter] public object? Item { get; set; }

    private object? modelInstance;
    private Dictionary<string, List<PropertyMetadata>> propriedadesPorSecao = new();
    private List<ActionMetadata> acoesDoModelo = new();
    private List<PropertyMetadata> propriedadesFiltradas = new();
    private string secaoAtiva = "";

    private string? mensagemFeedback;
    private bool sucessoFeedback;
    private bool salvando;
    private bool carregando = true;

    private string GetPanelTitle()
    {
        if (string.IsNullOrEmpty(EntityName)) return secaoAtiva;

        var entityFormatted = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(EntityName.ToLower());
        var acao = Id > 0 ? "Editar" : "Cadastro de";

        return string.IsNullOrEmpty(secaoAtiva) ? $"{acao} {entityFormatted}" : $"{acao} {entityFormatted} - {secaoAtiva}";
    }

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;

        try
        {
            var entityType = EntityRegistry.GetEntityType(EntityName);

            if (entityType != null)
            {
                modelInstance = Item ?? Activator.CreateInstance(entityType);
                bool isEditMode = Id > 0;

                var listProperties = ModelMetadataReader.GetProperties(modelInstance);
                propriedadesFiltradas = listProperties.Where(p => p.VisibleInDetail).ToList();

                foreach (var prop in propriedadesFiltradas)
                {
                    if (prop.ReadOnlyInDetail)
                    {
                        prop.ReadOnly = true;
                    }
                    else if (prop.ReadOnlyOnEdit && isEditMode)
                    {
                        prop.ReadOnly = true;
                    }
                }

                propriedadesPorSecao = propriedadesFiltradas
                    .GroupBy(p => p.Section ?? "Geral")
                    .ToDictionary(g => g.Key, g => g.ToList());

                acoesDoModelo = ModelMetadataReader.GetDetailActions(entityType, EntityName);

                if (propriedadesPorSecao.Any() && (string.IsNullOrEmpty(secaoAtiva) || !propriedadesPorSecao.ContainsKey(secaoAtiva)))
                {
                    secaoAtiva = propriedadesPorSecao.Keys.First();
                }
            }
            else
            {
                propriedadesPorSecao = new();
                acoesDoModelo = new();
                secaoAtiva = "";
            }
        }
        catch (Exception ex)
        {
            sucessoFeedback = false;
            mensagemFeedback = $"Erro ao carregar estrutura do formulário: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }

        if (modelInstance != null)
        {
            await CarregarDadosAssincronos();
        }
    }

    private async Task CarregarDadosAssincronos()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUserName = authState.User.Identity?.Name;

            foreach (var prop in propriedadesFiltradas)
            {
                var valorAtual = prop.GetValue(modelInstance);
                if (valorAtual == null || string.IsNullOrEmpty(valorAtual.ToString()))
                {
                    if (prop.DefaultValueType == DefaultValueType.CurrentUser && !string.IsNullOrEmpty(currentUserName))
                    {
                        prop.SetValue(modelInstance, currentUserName);
                    }
                    else if (prop.DefaultValueType == DefaultValueType.CurrentDate)
                    {
                        prop.SetValue(modelInstance, DateTime.Today);
                    }
                    else if (prop.DefaultValueType == DefaultValueType.CurrentDateTime)
                    {
                        prop.SetValue(modelInstance, DateTime.Now);
                    }
                }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { }

        var selectProps = propriedadesFiltradas
            .Where(p => p.FieldType == FieldType.Select && !string.IsNullOrEmpty(p.LookupKey))
            .ToList();

        foreach (var prop in selectProps)
        {
            try
            {
                var lookupData = await Http.GetFromJsonAsync<List<Dictionary<string, object>>>($"api/generic/{prop.LookupKey}");

                if (lookupData != null)
                {
                    var options = new Dictionary<string, string>();
                    foreach (var row in lookupData)
                    {
                        var keyCol = row.Keys.FirstOrDefault(k => k.Equals(prop.PropertyName, StringComparison.OrdinalIgnoreCase) || k.Equals("Id", StringComparison.OrdinalIgnoreCase) || k.StartsWith("Id", StringComparison.OrdinalIgnoreCase));
                        var descCol = row.Keys.FirstOrDefault(k => k.Equals("Descricao", StringComparison.OrdinalIgnoreCase) || k.Equals("Nome", StringComparison.OrdinalIgnoreCase));

                        if (keyCol != null && descCol != null)
                        {
                            string? idVal = row[keyCol]?.ToString();
                            string? descVal = row[descCol]?.ToString();
                            if (!string.IsNullOrEmpty(idVal) && !string.IsNullOrEmpty(descVal))
                            {
                                options[idVal] = descVal;
                            }
                        }
                    }
                    prop.Options = options;
                }
            }
            catch { }
        }

        await InvokeAsync(StateHasChanged);
    }

    private List<ActionMetadata> GetAcoesDaSecaoAtiva()
    {
        if (string.IsNullOrEmpty(secaoAtiva)) return new List<ActionMetadata>();

        var acoes = acoesDoModelo
            .Where(a => string.IsNullOrEmpty(a.Section) || a.Section.Equals(secaoAtiva, StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => a.Order)
            .ToList();

        if (!acoesDoModelo.Any())
        {
            acoes.Add(new ActionMetadata { Label = "Gravar", Icon = "fa fa-save", CssClass = "btn-success", ActionType = ActionType.Save, Order = 1 });
            acoes.Add(new ActionMetadata { Label = "Retornar", Icon = "fa fa-arrow-circle-left", CssClass = "btn-danger", ActionType = ActionType.Back, TargetUrl = $"/gerenciar/{EntityName}", Order = 2 });
        }

        return acoes;
    }

    private async Task ExecutarAcao(ActionMetadata acao)
    {
        if (acao.ActionType == ActionType.Save)
        {
            await Salvar();
        }
        else if (acao.ActionType == ActionType.Back)
        {
            Navigation.NavigateTo($"/gerenciar/{EntityName}");
        }
        else if (!string.IsNullOrEmpty(acao.TargetUrl))
        {
            Navigation.NavigateTo(acao.TargetUrl);
        }
    }

    private void MudarSecao(string nomeSecao)
    {
        secaoAtiva = nomeSecao;
    }

    private async Task Salvar()
    {
        if (modelInstance == null || salvando) return;

        var (isValid, errorMessage) = ModelValidator.Validar(modelInstance);
        if (!isValid)
        {
            sucessoFeedback = false;
            mensagemFeedback = errorMessage;
            StateHasChanged();
            return;
        }

        salvando = true;
        mensagemFeedback = null;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/generic/{EntityName}", modelInstance);
            var resultado = await response.Content.ReadFromJsonAsync<ResultadoOperacao>();

            if (response.IsSuccessStatusCode && resultado != null && resultado.Sucesso)
            {
                sucessoFeedback = true;
                mensagemFeedback = resultado.Mensagem;
                StateHasChanged();

                await Task.Delay(1200);
                Navigation.NavigateTo($"/gerenciar/{EntityName}");
            }
            else
            {
                sucessoFeedback = false;
                mensagemFeedback = resultado?.Mensagem ?? "Falha ao gravar os dados no banco de dados.";
            }
        }
        catch (Exception ex)
        {
            sucessoFeedback = false;
            mensagemFeedback = $"Erro de comunicação com o servidor: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }
}