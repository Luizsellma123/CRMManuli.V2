#nullable enable
@using System.Net.Http
@using System.Net.Http.Json
@inject HttpClient Http

@if (IsOpen)
{
    <div class="modal fade in d-block" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" @onclick="Fechar">&times;</button>
                    <h4 class="modal-title">Pesquisar @Title</h4>
                </div>
                <div class="modal-body">
                    <div class="input-group" style="margin-bottom: 15px;">
                        <input type="text" class="form-control" placeholder="Digite o nome, código ou CNPJ..." 
                               @bind="termoBusca" @bind:event="oninput" @onkeyup="VerificarEnter" />
                        <span class="input-group-btn">
                            <button class="btn btn-primary" type="button" @onclick="Buscar">
                                <i class="fa fa-search"></i> Pesquisar
                            </button>
                        </span>
                    </div>

                    @if (carregando)
                    {
                        <div class="text-center my-3" style="padding: 20px;">
                            <i class="fa fa-spinner fa-spin fa-2x"></i> Buscando registros...
                        </div>
                    }
                    else if (resultados != null && resultados.Any())
                    {
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th style="width: 100px;">Código</th>
                                        <th>Descrição / Nome</th>
                                        <th style="width: 90px; text-align: center;">Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in resultados)
                                    {
                                        <tr style="cursor: pointer;" @ondblclick="() => Selecionar(item.Key, item.Value)">
                                            <td><strong>@item.Key</strong></td>
                                            <td>@item.Value</td>
                                            <td style="text-align: center;">
                                                <button class="btn btn-xs btn-success" @onclick="() => Selecionar(item.Key, item.Value)">
                                                    Selecionar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (jaBuscou)
                    {
                        <div class="alert alert-warning mb-0">Nenhum registro encontrado.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" @onclick="Fechar">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string LookupKey { get; set; } = string.Empty;
    [Parameter] public EventCallback<KeyValuePair<string, string>> OnSelect { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string termoBusca = string.Empty;
    private Dictionary<string, string> resultados = new();
    private bool carregando;
    private bool jaBuscou;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !jaBuscou)
        {
            await Buscar();
        }
    }

    private async Task VerificarEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrEmpty(LookupKey)) return;

        carregando = true;
        jaBuscou = true;
        resultados.Clear();

        try
        {
            var url = $"api/generic/{LookupKey}?term={Uri.EscapeDataString(termoBusca)}";
            var data = await Http.GetFromJsonAsync<List<Dictionary<string, object>>>(url);

            if (data != null)
            {
                foreach (var row in data)
                {
                    var keyCol = row.Keys.FirstOrDefault(k => k.Equals("Id", StringComparison.OrdinalIgnoreCase) || k.StartsWith("Id", StringComparison.OrdinalIgnoreCase) || k.Equals("Codigo", StringComparison.OrdinalIgnoreCase));
                    var descCol = row.Keys.FirstOrDefault(k => k.Equals("Nome", StringComparison.OrdinalIgnoreCase) || k.Equals("RazaoSocial", StringComparison.OrdinalIgnoreCase) || k.Equals("Descricao", StringComparison.OrdinalIgnoreCase));

                    if (keyCol != null && descCol != null)
                    {
                        string id = row[keyCol]?.ToString() ?? "";
                        string desc = row[descCol]?.ToString() ?? "";
                        if (!string.IsNullOrEmpty(id))
                        {
                            resultados[id] = desc;
                        }
                    }
                }
            }
        }
        catch { }
        finally
        {
            carregando = false;
        }
    }

    private async Task Selecionar(string key, string value)
    {
        await OnSelect.InvokeAsync(new KeyValuePair<string, string>(key, value));
        await Fechar();
    }

    private async Task Fechar()
    {
        termoBusca = string.Empty;
        resultados.Clear();
        jaBuscou = false;
        await OnClose.InvokeAsync(EventArgs.Empty);
    }
}